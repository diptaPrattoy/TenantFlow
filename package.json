{
  "name": "tenantflow",
  "version": "0.1.0",
  "private": true,
  "description": "TenantFlow - multi-tenant SaaS subscription platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "typecheck": "npm run typecheck --workspace=backend && npm run typecheck --workspace=frontend",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:deploy": "npm run db:deploy --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:studio": "npm run db:studio --workspace=backend",
    "db:check": "npm run db:check --workspace=backend",
    "stripe:sync-plans": "npm run stripe:sync-plans --workspace=backend"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
