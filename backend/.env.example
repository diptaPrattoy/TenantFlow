NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Pooled Neon connection used by the running API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Direct Neon connection used by Prisma migrations.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Use a long random value in local development and production.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN_SECONDS=3600

# Optional development seed account. Set these before running db:seed
# if you want a platform admin account immediately.
SEED_PLATFORM_ADMIN_NAME=Platform Admin
SEED_PLATFORM_ADMIN_EMAIL=admin@tenantflow.local
SEED_PLATFORM_ADMIN_PASSWORD=ChangeMe123!
